{
	"name": "spl_master_pl",
	"properties": {
		"activities": [
			{
				"name": "ForEachSPL_File",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Source_File_List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Source_File_List').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set_filename",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "file_name",
								"value": {
									"value": "@concat('spl_fall2026_',substring(replace(split(item().name,'_')[3],'.csv',''),0,4),'_',substring(replace(split(item().name,'_')[3],'.csv',''),4,2),'_',substring(replace(split(item().name,'_')[3],'.csv',''),6,2),'.parquet')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Execute_convert_to_parquet",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Set_filename",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "source_to_parquet_pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"target_container_name": {
										"value": "@pipeline().parameters.target_container_name",
										"type": "Expression"
									},
									"source_container_name": {
										"value": "@pipeline().parameters.source_container_name",
										"type": "Expression"
									},
									"target_folder_name": {
										"value": "@pipeline().parameters.target_folder_name",
										"type": "Expression"
									},
									"source_folder_name": {
										"value": "@pipeline().parameters.source_folder_name",
										"type": "Expression"
									},
									"source_file_name": {
										"value": "@item().name",
										"type": "Expression"
									},
									"target_file_name": {
										"value": "@variables('file_name')",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Get_Source_File_List",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "csv_folder_ds",
						"type": "DatasetReference",
						"parameters": {
							"container_name": "@pipeline().parameters.source_container_name",
							"folder_name": "@pipeline().parameters.source_folder_name"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"source_container_name": {
				"type": "string",
				"defaultValue": "source-files"
			},
			"source_folder_name": {
				"type": "string",
				"defaultValue": "seattle_pet_license"
			},
			"target_container_name": {
				"type": "string",
				"defaultValue": "raw"
			},
			"target_folder_name": {
				"type": "string",
				"defaultValue": "spl_part_b"
			}
		},
		"variables": {
			"file_name": {
				"type": "String"
			}
		},
		"annotations": []
	}
}